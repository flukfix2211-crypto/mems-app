function importLegacyBorrowRecords() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const sheet = getOrCreateSheet(ss, SHEET_BORROW);

  if (sheet.getLastRow() === 0) {
    sheet.appendRow([
      'ลำดับ', 'วันที่', 'เวลา', 'เวร',
      'ประเภท (ยืม/คืน/Round)', 'ชื่อเครื่อง', 'หมายเลขเครื่อง',
      'ตึก/Ward', 'ชื่อผู้บันทึก', 'Timestamp (ISO)',
      'สถานะ Round', 'หมายเหตุ'
    ]);
    sheet.setFrozenRows(1);
    formatHeader(sheet);
  }

  // กันการนำเข้าซ้ำ: เช็ค Timestamp ของแถวแรกในชุดข้อมูลนี้ว่ามีอยู่แล้วหรือยัง
  const firstTs = LEGACY_BORROW_ROWS[0][8];
  if (sheet.getLastRow() > 1) {
    const existingTs = sheet.getRange(2, 10, sheet.getLastRow() - 1, 1).getValues().map(r => String(r[0]));
    if (existingTs.some(ts => ts.indexOf(firstTs) === 0 || ts === firstTs)) {
      Logger.log('ดูเหมือนข้อมูลชุดนี้ถูกนำเข้าไปแล้ว (พบ Timestamp ' + firstTs + ' อยู่ก่อน) — ยกเลิกการนำเข้าเพื่อกันข้อมูลซ้ำ');
      return;
    }
  }

  let seq = sheet.getLastRow(); // ลำดับต่อจากแถวสุดท้ายปัจจุบัน (header ไม่นับ)
  const startRow = sheet.getLastRow() + 1;

  const values = LEGACY_BORROW_ROWS.map(r => {
    seq++;
    return [seq, r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10]];
  });

  sheet.getRange(startRow, 1, values.length, 12).setValues(values);

  // ใส่สีแถวตามประเภท (ยืม/คืน) เหมือน saveRecord()
  const colors = LEGACY_BORROW_ROWS.map(r => {
    const action = r[3] || '';
    return Array(12).fill(action.indexOf('ยืม') !== -1 ? '#DCF2E5' : '#FDEAEA');
  });
  sheet.getRange(startRow, 1, colors.length, 12).setBackgrounds(colors);

  Logger.log('นำเข้าข้อมูลสำเร็จ: ' + values.length + ' รายการ (แถว ' + startRow + '-' + (startRow + values.length - 1) + ')');
}
